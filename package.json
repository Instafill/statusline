{
  "name": "statusline",
  "version": "0.3.4",
  "private": true,
  "description": "Claude Code Capability Watcher - local-only session observer and professional-work classifier (Windows + macOS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Instafill/statusline.git"
  },
  "main": "src/cli.js",
  "scripts": {
    "start": "node src/cli.js start",
    "install-hooks": "node src/cli.js install",
    "uninstall-hooks": "node src/cli.js uninstall",
    "status": "node src/cli.js status",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "prettier --check . && eslint . --max-warnings=0 && node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
