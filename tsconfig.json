{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.js",
    "hooks/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "statusline-segment.js"
  ]
}
